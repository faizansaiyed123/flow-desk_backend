# --- App ---
APP_NAME=FlowDesk API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-64-byte-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/flowdesk
DATABASE_ECHO=false

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15

# --- Email (optional in dev; if unset, emails are logged not sent) ---
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@flowdesk.app

# --- Frontend origin used in email links (invites, password reset) ---
FRONTEND_URL=http://localhost:5173

# --- Redis (optional; enables webhook delivery queue & rate limiting store) ---
REDIS_URL=
